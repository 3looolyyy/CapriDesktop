{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/shared/**/*",
    "src/preload/**/*"
  ]
}
